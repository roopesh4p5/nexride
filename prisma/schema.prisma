// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RIDER
  DRIVER
  ADMIN
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  phoneNumber   String?
  role          UserRole @default(RIDER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Rider specific relationships
  ridesAsRider  Ride[]   @relation("RiderToRide")
  
  // Driver specific relationship
  driverProfile Driver?
}

model Driver {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  vehicleModel  String
  vehiclePlate  String   @unique
  isAvailable   Boolean  @default(false)
  ridesAsDriver Ride[]   @relation("DriverToRide")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Ride {
  id              String     @id @default(uuid())
  riderId         String
  rider           User       @relation("RiderToRide", fields: [riderId], references: [id])
  driverId        String?
  driver          Driver?    @relation("DriverToRide", fields: [driverId], references: [id])
  
  // Location details
  pickupLocation  String
  dropoffLocation String
  pickupLat       Float
  pickupLng       Float
  dropoffLat      Float
  dropoffLng      Float
  
  // Ride details
  status          RideStatus @default(REQUESTED)
  fare            Float?
  distance        Float?
  estimatedTime   Int?       // in minutes
  
  // Timestamps
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  payment         Payment?
}

model Payment {
  id        String   @id @default(uuid())
  rideId    String   @unique
  ride      Ride     @relation(fields: [rideId], references: [id])
  amount    Float
  status    String   @default("PENDING")
  method    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
